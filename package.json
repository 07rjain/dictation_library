{
  "name": "groq-dictation-kit",
  "version": "0.4.0",
  "description": "Fast, reusable browser dictation pipeline powered by Groq.",
  "author": "07rjain",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "BENCHMARKS.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node web/server.mjs",
    "start": "node web/server.mjs",
    "test": "npm run test:regression",
    "test:regression": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "test:live": "npm run build && node scripts/live-smoke.mjs",
    "test:long:live": "npm run build && node scripts/live-long.mjs",
    "test:batch:live": "npm run build && node scripts/live-batch.mjs",
    "test:boundaries:live": "npm run build && node scripts/live-boundaries.mjs",
    "benchmark:long": "npm run build && node scripts/benchmark-long.mjs",
    "check": "npm run test",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "dictation",
    "groq",
    "speech-to-text",
    "whisper",
    "typescript",
    "voice-typing",
    "browser-audio"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/07rjain/dictation_library.git"
  },
  "homepage": "https://github.com/07rjain/dictation_library#readme",
  "bugs": {
    "url": "https://github.com/07rjain/dictation_library/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.2",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.2"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  }
}
