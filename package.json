{
  "name": "@dictation-kit/core",
  "version": "0.1.0",
  "description": "Fast, reusable browser dictation pipeline powered by Groq.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node web/server.mjs",
    "start": "node web/server.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:live": "npm run build && node scripts/live-smoke.mjs",
    "check": "npm run test"
  },
  "keywords": [
    "dictation",
    "groq",
    "speech-to-text",
    "whisper",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
